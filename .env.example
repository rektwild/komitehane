# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payload / Neon
DATABASE_URL=postgresql://USER:PASSWORD@EP-POOLER.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@EP.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Cloudflare R2
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.example.com
NEXT_PUBLIC_MEDIA_HOSTNAME=media.example.com

# SEO
DEPLOYMENT_ENV=development
ALLOW_MODEL_TRAINING_CRAWLERS=false
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
INDEXNOW_KEY=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# Google AdSense
# Production enables AdSense when a valid client ID is present.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_MIDDLE=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_LISTING=
# Optional: set false to disable production ads. Non-production requires both
# flags below to be true and must never be enabled in automated test runs.
NEXT_PUBLIC_ADSENSE_ENABLED=
NEXT_PUBLIC_ADSENSE_ENABLE_NON_PRODUCTION=
