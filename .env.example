# The single production origin used for metadata, canonical URLs, hreflang, and sitemaps.
NEXT_PUBLIC_SITE_URL=https://example.com

# Set to preview or staging on non-production deployments to force noindex/Disallow: /.
# Vercel deployments use VERCEL_ENV automatically.
DEPLOYMENT_ENV=production

# Optional Search Console / Bing Webmaster verification values.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Search/retrieval crawlers remain allowed by default. Training crawlers are blocked
# unless this is explicitly set to true.
ALLOW_MODEL_TRAINING_CRAWLERS=false

# Optional IndexNow configuration. INDEXNOW_KEY is served only at its verification path.
INDEXNOW_KEY=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
