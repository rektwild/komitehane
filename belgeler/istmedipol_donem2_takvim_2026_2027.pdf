</script><script type="10ae996ef465f4e3fe565afb-text/javascript">
(function() {
var scrollY = 0;
function lockBodyScroll() {
scrollY = window.scrollY;
document.body.style.position = 'fixed';
document.body.style.top = '-' + scrollY + 'px';
document.body.style.width = '100%';
document.body.style.overflowY = 'scroll';
}
function unlockBodyScroll() {
document.body.style.position = '';
document.body.style.top = '';
document.body.style.width = '';
document.body.style.overflowY = '';
window.scrollTo(0, scrollY);
}
function isMobile() {
return window.innerWidth <= 992;
}
document.addEventListener('click', function(e) {
if (!isMobile()) return;
var livechatBtn = e.target.closest('button.livechat');
if (livechatBtn) {
setTimeout(function() {
var lhcWidget = document.getElementById('lhc_widget_v2');
if (lhcWidget && lhcWidget.style.display !== 'none') {
lockBodyScroll();
}
}, 300);
}
});
document.addEventListener('LHCChat:close', function() {
unlockBodyScroll();
});
window.addEventListener('message', function(e) {
if (!isMobile()) return;
if (e.data && e.data.type === 'lhc_widget_closed') {
unlockBodyScroll();
}
});
var observer = new MutationObserver(function() {
if (!isMobile()) return;
var lhcWidget = document.getElementById('lhc_widget_v2');
if (!lhcWidget) return;
if (lhcWidget.style.display === 'none' || lhcWidget.style.visibility === 'hidden') {
unlockBodyScroll();
}
});
document.addEventListener('DOMContentLoaded', function() {
var target = document.getElementById('lhc_widget_v2');
if (target) {
observer.observe(target, { attributes: true, attributeFilter: ['style', 'class'] });
}
});
})();
</script><div id="chatbot-iframe-container"><iframe
