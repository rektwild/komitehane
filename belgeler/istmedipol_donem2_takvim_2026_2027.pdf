height="0" width="0" style="display:none;visibility:hidden" title="Gömülü içerik"></iframe></noscript><script type="10ae996ef465f4e3fe565afb-text/javascript">var LHC_API = LHC_API||{};
LHC_API.args = {
mode:'widget',lhc_base_url:'//livechat.medipol.edu.tr/',wheight:320,wwidth:350,pheight:520,pwidth:500,
leaveamessage:true,department:["2"],
